---
import { Image } from "astro:assets";
import { projects } from "@/data";
import Section from "../section-heading.astro";

const linkLabel = (href: string) => {
  const host = new URL(href).hostname.replace(/^www\./, "");
  return host === "apps.apple.com" ? "App Store" : host;
};
---

<Section id="projects" title="Projects">
  <ul class="flex flex-col gap-12">
    {
      projects.map((p) => (
        <li class="grid gap-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-8">
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="group relative block aspect-16/10 self-start overflow-hidden border border-rule bg-surface"
          >
            {/* Blurred backdrop: a 48px copy is enough under blur-2xl. */}
            <Image
              src={p.image}
              alt=""
              width={48}
              class="absolute inset-0 h-full w-full scale-110 object-cover opacity-40 blur-2xl"
            />
            <Image
              src={p.image}
              alt={p.imageAlt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 1152px) 440px, (min-width: 640px) 40vw, 100vw"
              class="relative h-full w-full object-contain p-3 drop-shadow-md transition-transform duration-300 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
            />
          </a>
          <div class="max-w-[65ch]">
            <h3 class="type-heading text-[1.75rem]">{p.title}</h3>
            <p class="mt-3">{p.description}</p>
            <dl class="mt-4 grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-1 text-[0.9375rem]">
              <dt class="text-muted">Stack</dt>
              <dd>{p.tags.join(", ")}</dd>
              {p.href && (
                <>
                  <dt class="text-muted">Live</dt>
                  <dd>
                    <a href={p.href} target="_blank" rel="noopener noreferrer" class="underline">
                      {linkLabel(p.href)}
                    </a>
                  </dd>
                </>
              )}
            </dl>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
