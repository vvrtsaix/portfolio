---
import { Image } from "astro:assets";
import { certifications, experiences } from "@/data";

const START_YEAR = 2019;
const years = new Date().getFullYear() - START_YEAR;
const current = experiences[0];
---

<section id="top" class="pt-10 sm:pt-16" aria-labelledby="name">
  <div class="flex items-end justify-between gap-6">
    <!-- "Uurtsaikh" sets ~3.2em wide: 27vw fills a phone; 20vw leaves room for the portrait from sm up. -->
    <h1 id="name" class="type-display text-[clamp(4.5rem,27vw,17rem)] sm:text-[min(20vw,17rem)]">
      Uurtsaikh<br />Nyambat
    </h1>
    <Image
      width="384"
      height="384"
      loading="eager"
      alt="Portrait of Uurtsaikh Nyambat"
      src="/images/profile.webp"
      class="mb-2 hidden h-36 w-28 flex-none object-cover sm:block lg:h-48 lg:w-36"
    />
  </div>

  <div class="mt-10 grid gap-10 md:grid-cols-[13rem_1fr] md:gap-10">
    <p class="type-sub text-2xl leading-tight">
      Senior software developer. I build payment, loyalty and cloud platforms, and the apps that run on them.
    </p>

    <div>
      <!-- Spec rows double as the page's one load animation: rules draw in, staggered. -->
      <dl class="spec">
        <div>
          <dt>Current role</dt>
          <dd>{current.position}, {current.company}</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Backend, full-stack and DevOps engineering</dd>
        </div>
        <div>
          <dt>Working since</dt>
          <dd>{START_YEAR}, {years} years in production software</dd>
        </div>
        <div>
          <dt>Certified</dt>
          <dd>
            <ul class="flex flex-col gap-2">
              {
                certifications.map((cert) => (
                  <li class="flex items-center gap-3">
                    <img src={cert.imageUrl} alt="" width="32" height="32" class="h-8 w-8 object-contain" />
                    <a href={cert.href} target="_blank" rel="noopener noreferrer" class="underline">
                      {cert.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:vvrtsaix.n@gmail.com" class="underline">vvrtsaix.n@gmail.com</a></dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="bg-ink px-5 py-3 font-semibold text-paper hover:bg-accent">Get in touch</a>
        <a href="/cv.pdf" download class="border border-ink px-5 py-3 font-semibold hover:border-accent hover:text-accent">Download CV (PDF)</a>
        <a href="https://www.linkedin.com/in/uurtsaikh-nyambat" target="_blank" rel="noopener noreferrer" class="px-3 py-3 underline">LinkedIn</a>
        <a href="https://github.com/vvrtsaix" target="_blank" rel="noopener noreferrer" class="px-3 py-3 underline">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .spec > div {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
  }
  .spec dt {
    color: rgb(var(--muted));
  }
  /* Row rule drawn as a pseudo-element so it can animate in. */
  .spec > div::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: rgb(var(--rule));
    transform-origin: left;
    animation: draw 600ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .spec > div:first-child::before {
    background: rgb(var(--ink));
  }
  .spec > div:nth-child(2)::before { animation-delay: 60ms; }
  .spec > div:nth-child(3)::before { animation-delay: 120ms; }
  .spec > div:nth-child(4)::before { animation-delay: 180ms; }
  .spec > div:nth-child(5)::before { animation-delay: 240ms; }
  .spec > div:nth-child(6)::before { animation-delay: 300ms; }
  @keyframes draw {
    from { transform: scaleX(0); }
  }
  @media (max-width: 30rem) {
    .spec > div {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
  }
</style>
