---
import { experiences } from "@/data";
import Section from "../section-heading.astro";
---

<Section id="experience" title="Experience">
  <ol>
    {
      experiences.map((job) => (
        <li class="grid gap-1 border-t border-rule py-6 first:border-t-0 first:pt-0 sm:grid-cols-[11rem_1fr] sm:gap-6">
          <p class="text-sm text-muted sm:pt-1">{job.date.replace(" - ", " – ")}</p>
          <div class="max-w-[65ch]">
            <h3 class="type-sub text-[1.375rem] leading-snug">
              {job.position}<span class="font-normal text-muted">, {job.company}</span>
            </h3>
            {job.details.length > 0 && (
              <ul class="mt-2 list-disc space-y-2 pl-5 marker:text-rule">
                {job.details.map((d) => <li>{d}</li>)}
              </ul>
            )}
            {job.stack && (
              <p class="mt-3 text-[0.9375rem]">
                <span class="text-muted">Stack</span> {job.stack.join(", ")}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
