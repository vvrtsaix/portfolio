---
import Section from "../section-heading.astro";
import ContactForm from "./form";

const channels = [
  { label: "Email", text: "vvrtsaix.n@gmail.com", href: "mailto:vvrtsaix.n@gmail.com" },
  { label: "WhatsApp", text: "+976 8666 6217", href: "https://wa.me/97686666217" },
  { label: "LinkedIn", text: "uurtsaikh-nyambat", href: "https://www.linkedin.com/in/uurtsaikh-nyambat" },
  { label: "GitHub", text: "vvrtsaix", href: "https://github.com/vvrtsaix" },
];
---

<Section id="contact" title="Contact">
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-10">
    <div>
      <p class="type-sub max-w-[30ch] text-2xl leading-tight">
        Hiring for platform, backend or DevOps work? Write directly or use the form.
      </p>
      <dl class="mt-6">
        {
          channels.map((c) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-3 border-t border-rule py-2">
              <dt class="text-muted">{c.label}</dt>
              <dd class="min-w-0 break-words">
                <a
                  href={c.href}
                  class="underline"
                  {...(c.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {c.text}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <ContactForm client:visible />
  </div>
</Section>
